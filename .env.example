# Copy to .env locally; never commit actual secrets.
DATABASE_NAME=mailclient
DATABASE_USER=mailclient
DATABASE_PASSWORD=
MAIL_ADMIN_USERNAME=admin
# At least 16 characters, unique to this application.
MAIL_ADMIN_PASSWORD=
# Generate with: openssl rand -base64 32
MAIL_ENCRYPTION_KEY=
# Public HTTPS origin of your private app, no trailing slash.
MAIL_ALLOWED_ORIGIN=https://mail.example.com
# Provider OAuth settings are documented in docs/PROVIDER_SETUP.md.
MAIL_OAUTH_GMAIL_CLIENT_ID=
MAIL_OAUTH_GMAIL_CLIENT_SECRET=
MAIL_OAUTH_GMAIL_REDIRECT_URI=
MAIL_OAUTH_OUTLOOK_CLIENT_ID=
MAIL_OAUTH_OUTLOOK_CLIENT_SECRET=
MAIL_OAUTH_OUTLOOK_REDIRECT_URI=
MAIL_OAUTH_OUTLOOK_TENANT=consumers
MAIL_OAUTH_EXCHANGE_CLIENT_ID=
MAIL_OAUTH_EXCHANGE_CLIENT_SECRET=
MAIL_OAUTH_EXCHANGE_REDIRECT_URI=
MAIL_OAUTH_EXCHANGE_TENANT=organizations
